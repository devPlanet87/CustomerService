@model ServiceVaultWeb.Models.CustomerInfo
@{
    ViewData["Title"] = "Edit Customer";
}

<h2>Edit Customer Info</h2>

<form asp-action="Edit" method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="CustomerId" />

    <div class="mb-3">
        <label asp-for="CustomerName" class="form-label">@Html.DisplayNameFor(m => m.CustomerName) <span class="text-danger">*</span></label>
        <input asp-for="CustomerName" class="form-control form-control-sm" />
        <span asp-validation-for="CustomerName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="NickName" class="form-label"></label>
        <input asp-for="NickName" class="form-control form-control-sm" />
    </div>

    <div class="mb-3">
        <label asp-for="MobileNumber" class="form-label"></label>
        <input asp-for="MobileNumber" class="form-control form-control-sm" />
    </div>

    <div class="mb-3">
        <label asp-for="AlternateNumber" class="form-label"></label>
        <input asp-for="AlternateNumber" class="form-control form-control-sm" />
    </div>

    <div class="mb-3">
        <label asp-for="Address" class="form-label"></label>
        <textarea asp-for="Address" class="form-control form-control-sm"></textarea>
    </div>

    <div class="mb-3">
        <label asp-for="Relationship" class="form-label"></label>
        <input asp-for="Relationship" class="form-control form-control-sm" />
    </div>

    <div class="mb-3">
        <label asp-for="Notes" class="form-label"></label>
        <textarea asp-for="Notes" class="form-control form-control-sm"></textarea>
    </div>

    <div class="mb-3">
        <label class="form-label">Image</label>
        <input type="file" name="imageFile" class="form-control form-control-sm" />
        @if (!string.IsNullOrEmpty(Model.ImagePath))
        {
            <div class="mt-2">
                <a href="/ProductOrWarrantyImages/@Model.ImagePath" target="_blank">View image</a>
            </div>
        }
    </div>

    <div class="mb-3">
        <label asp-for="MapLocation" class="form-label"></label>
        <input asp-for="MapLocation" class="form-control form-control-sm" />
    </div>

    <button type="submit" class="btn btn-sm btn-primary">Save</button>
    <a class="btn btn-sm btn-secondary" href="/Customers">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
